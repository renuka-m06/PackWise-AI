# ==============================================================================
# PackWise AI - Environment Configuration Template
# Copy this file to .env and configure for local or production deployment.
# NEVER commit .env with real secrets to version control.
# ==============================================================================

# Application Runtime Environment
APP_ENV=development
DEBUG=true
SERVICE_NAME=foodpack-api

# API Gateway Configuration
API_PREFIX=/api/v1

# PostgreSQL Database Credentials
POSTGRES_USER=packwise_user
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=packwise_db
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# SQLAlchemy Connection String
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Machine Learning Artifact Directory
MODEL_DIR=ml/models

# Frontend Environment (Vite)
VITE_API_URL=http://localhost:8000/api/v1
